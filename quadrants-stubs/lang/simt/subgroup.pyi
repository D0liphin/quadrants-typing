from quadrants import i32, u32, u64

# re-exported reduce / scan / segmented-reduce APIs (defined in `reductions`) and
# sorting APIs (defined in `sorting`)
from quadrants.lang.simt.reductions import *  # noqa: F403
from quadrants.lang.simt.sorting import *  # noqa: F403

from quadrants_typing._algebra import _BallotWidth, _Log2Size, _Num

# barriers / fences
def sync() -> None: ...
def mem_fence() -> None: ...
def barrier() -> None: ...  # deprecated alias of `sync`
def memory_barrier() -> None: ...  # deprecated alias of `mem_fence`

# election
def elect() -> i32: ...

# ballots
def ballot_first_n(predicate: i32, n: _BallotWidth) -> u32: ...
def ballot(predicate: i32) -> u64: ...
def ballot_full_subgroup(predicate: i32) -> u64: ...  # deprecated alias of `ballot`

# votes
def all_true_tiled(predicate: i32, log2_size: _Log2Size) -> i32: ...
def any_true_tiled(predicate: i32, log2_size: _Log2Size) -> i32: ...
def all_equal_tiled(value: _Num, log2_size: _Log2Size) -> i32: ...
def all_true(predicate: i32) -> i32: ...
def any_true(predicate: i32) -> i32: ...
def all_equal(value: _Num) -> i32: ...

# broadcast
def broadcast(value: _Num, index: u32) -> _Num: ...
def broadcast_first(value: _Num) -> _Num: ...

# lane masks
def lanemask_lt(lane_id: u32) -> u32: ...
def lanemask_le(lane_id: u32) -> u32: ...
def lanemask_eq(lane_id: u32) -> u32: ...
def lanemask_gt(lane_id: u32) -> u32: ...
def lanemask_ge(lane_id: u32) -> u32: ...

# subgroup geometry
def group_size() -> int: ...
def log2_group_size() -> int: ...
def invocation_id() -> i32: ...

# shuffles
def shuffle(value: _Num, index: u32) -> _Num: ...
def shuffle_xor(value: _Num, mask: u32) -> _Num: ...
def shuffle_up(value: _Num, offset: u32) -> _Num: ...
def shuffle_down(value: _Num, offset: u32) -> _Num: ...
