def pow(base: _Num, exponent: _Num) -> _Num: ...
@overload  # vector
def pow(base: qdt.Vec[_Num, _Dim] | _Num, exponent: qdt.Vec[_Num, _Dim] | _Num) -> qdt.Vec[_Num, _Dim]: ...
@overload  # matrix
