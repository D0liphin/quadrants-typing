# vector operations
#
# `dot`/`length`/`distance`/`cross` (vec2) return the element type; `normalize`/
# `reflect`/`cross` (vec3) return the input vector unchanged.

def dot(x: qdt.Vec[_Num, _Dim], y: qdt.Vec[_Num, _Dim]) -> _Num: ...
@overload  # vec2
def cross(x: qdt.Vec[_Num, qdt.Dim2], y: qdt.Vec[_Num, qdt.Dim2]) -> _Num: ...
@overload  # vec3
def cross(x: qdt.Vec[_Num, qdt.Dim3], y: qdt.Vec[_Num, qdt.Dim3]) -> qdt.Vec[_Num, qdt.Dim3]: ...
def normalize(v: qdt.Vec[_Num, _Dim]) -> qdt.Vec[_Num, _Dim]: ...
def reflect(x: qdt.Vec[_Num, _Dim], n: qdt.Vec[_Num, _Dim]) -> qdt.Vec[_Num, _Dim]: ...
def length(x: qdt.Vec[_Num, _Dim]) -> _Num: ...
def distance(x: qdt.Vec[_Num, _Dim], y: qdt.Vec[_Num, _Dim]) -> _Num: ...
def refract(x: qdt.Vec[_Num, _Dim], n: qdt.Vec[_Num, _Dim], eta: _Num) -> qdt.Vec[_Num, _Dim]: ...

# matrix operations
#
# `determinant` returns the element type and `inverse` keeps its square
# `Mat[_Num, _Dim, _Dim]` shape.

def determinant(m: qdt.Mat[_Num, _Dim, _Dim]) -> _Num: ...
def inverse(mat: qdt.Mat[_Num, _Dim, _Dim]) -> qdt.Mat[_Num, _Dim, _Dim]: ...
def eye(n: int) -> qdt.Mat[f32, qdt.DimAny, qdt.DimAny]: ...

# complex vec2 operations
#
# These preserve the vec2 they are given (pinned to `qdt.Dim2`). `cpow` takes a
# scalar exponent of the element type.

def cconj(z: qdt.Vec[_Num, qdt.Dim2]) -> qdt.Vec[_Num, qdt.Dim2]: ...
def cdiv(z1: qdt.Vec[_Num, qdt.Dim2], z2: qdt.Vec[_Num, qdt.Dim2]) -> qdt.Vec[_Num, qdt.Dim2]: ...
def cexp(z: qdt.Vec[_Num, qdt.Dim2]) -> qdt.Vec[_Num, qdt.Dim2]: ...
def cinv(z: qdt.Vec[_Num, qdt.Dim2]) -> qdt.Vec[_Num, qdt.Dim2]: ...
def clog(z: qdt.Vec[_Num, qdt.Dim2]) -> qdt.Vec[_Num, qdt.Dim2]: ...
def cmul(z1: qdt.Vec[_Num, qdt.Dim2], z2: qdt.Vec[_Num, qdt.Dim2]) -> qdt.Vec[_Num, qdt.Dim2]: ...
def csqrt(z: qdt.Vec[_Num, qdt.Dim2]) -> qdt.Vec[_Num, qdt.Dim2]: ...
def cpow(z: qdt.Vec[_Num, qdt.Dim2], n: _Num) -> qdt.Vec[_Num, qdt.Dim2]: ...

