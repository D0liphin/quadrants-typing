# fmt: off

from typing import TypeVar, overload

from quadrants.types.primitive_types import f32, f64, i16, i32, i64, u16, u32, u64

import quadrants_typing as qdt
from quadrants_typing._algebra import _Col, _Dim, _Num, _Row

pi: float
e: float
inf: float
nan: float

# vector / matrix constructors

vec2 = qdt.Vec[float, qdt.Dim2]
vec3 = qdt.Vec[float, qdt.Dim3]
vec4 = qdt.Vec[float, qdt.Dim4]
ivec2 = qdt.Vec[int, qdt.Dim2]
ivec3 = qdt.Vec[int, qdt.Dim3]
ivec4 = qdt.Vec[int, qdt.Dim4]
uvec2 = qdt.Vec[qdt.uint, qdt.Dim2]
uvec3 = qdt.Vec[qdt.uint, qdt.Dim3]
uvec4 = qdt.Vec[qdt.uint, qdt.Dim4]
mat2 = qdt.Mat[float, qdt.Dim2, qdt.Dim2]
mat3 = qdt.Mat[float, qdt.Dim3, qdt.Dim3]
mat4 = qdt.Mat[float, qdt.Dim4, qdt.Dim4]

# unary element-wise
#
# One overload per shape. `_Num` is a constrained TypeVar over every concrete
# dtype, so a scalar echoes its exact type back and a container echoes its exact
# element and dimensions back — no widening, no builtin/nominal split.

# acos
@overload  # scalar
def acos(x: _Num) -> _Num: ...
@overload  # vector
def acos(x: qdt.Vec[_Num, _Dim]) -> qdt.Vec[_Num, _Dim]: ...
@overload  # matrix
def acos(x: qdt.Mat[_Num, _Row, _Col]) -> qdt.Mat[_Num, _Row, _Col]: ...

