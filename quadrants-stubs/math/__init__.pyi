# binary / ternary element-wise
#
# These broadcast a scalar against the container, so the scalar arg shares the
# container's element type via the same `_Num`: `Vec[_Num, _Dim] | _Num`.

# atan2
@overload  # scalar
def atan2(x1: _Num, x2: _Num) -> _Num: ...
@overload  # vector
def atan2(x1: qdt.Vec[_Num, _Dim] | _Num, x2: qdt.Vec[_Num, _Dim] | _Num) -> qdt.Vec[_Num, _Dim]: ...
@overload  # matrix
def atan2(x1: qdt.Mat[_Num, _Row, _Col] | _Num, x2: qdt.Mat[_Num, _Row, _Col] | _Num) -> qdt.Mat[_Num, _Row, _Col]: ...

# mod
@overload  # scalar
def mod(x: _Num, y: _Num) -> _Num: ...
@overload  # vector
def mod(x: qdt.Vec[_Num, _Dim] | _Num, y: qdt.Vec[_Num, _Dim] | _Num) -> qdt.Vec[_Num, _Dim]: ...
@overload  # matrix
def mod(x: qdt.Mat[_Num, _Row, _Col] | _Num, y: qdt.Mat[_Num, _Row, _Col] | _Num) -> qdt.Mat[_Num, _Row, _Col]: ...

