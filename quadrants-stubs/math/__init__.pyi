@overload  # scalar
def asin(x: _Num) -> _Num: ...
@overload  # vector
def asin(x: qdt.Vec[_Num, _Dim]) -> qdt.Vec[_Num, _Dim]: ...
@overload  # matrix
def asin(x: qdt.Mat[_Num, _Row, _Col]) -> qdt.Mat[_Num, _Row, _Col]: ...

# cos
