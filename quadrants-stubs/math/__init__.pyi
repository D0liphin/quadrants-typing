@overload  # matrix
def clamp(x: qdt.Mat[_Num, _Row, _Col] | _Num, xmin: qdt.Mat[_Num, _Row, _Col] | _Num, xmax: qdt.Mat[_Num, _Row, _Col] | _Num) -> qdt.Mat[_Num, _Row, _Col]: ...

